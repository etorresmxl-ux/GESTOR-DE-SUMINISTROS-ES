# URL principal de la base de datos
DATABASE_URL=postgresql://user:password@host:5432/database

# Alias alternativo usado por Supabase
SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# Alias adicional
POSTGRES_URL=postgresql://user:password@host:5432/database

# Si usas Streamlit secrets, también puedes mantener:
# [postgres]
# url = "postgresql://user:password@host:5432/database"

# Nota: reemplaza los valores de ejemplo por tus credenciales reales.
